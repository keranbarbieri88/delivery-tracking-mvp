{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Database: Up (PostgreSQL)",
      "type": "shell",
      "command": "docker compose up -d",
      "problemMatcher": []
    },
    {
      "label": "Dev: Full Stack (Backend + Frontend)",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Backend: Run (Spring Boot)",
        "Frontend: Dev Server (React)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: Run (Spring Boot)",
      "type": "shell",
      "command": "./mvnw spring-boot:run",
      "windows": {
        "command": ".\\mvnw.cmd spring-boot:run"
      },
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(Starting|Initializing).*",
          "endsPattern": ".*Started .* in .* seconds.*"
        }
      }
    },
    {
      "label": "Frontend: Dev Server (React)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(VITE|ready in).*",
          "endsPattern": ".*Local:.*"
        }
      }
    },
    {
      "label": "Backend: Unit Tests",
      "type": "shell",
      "command": "./mvnw test",
      "windows": {
        "command": ".\\mvnw.cmd test"
      },
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Frontend: Unit Tests",
      "type": "shell",
      "command": "npm run test -- --run",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Frontend: Linter",
      "type": "shell",
      "command": "npm run lint",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [
        "$eslint-stylish"
      ]
    },
    {
      "label": "Quality: All Tests & Lint",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Backend: Unit Tests",
        "Frontend: Unit Tests",
        "Frontend: Linter"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}